# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage

# Screenshots de desarrollo (root histórico + nueva carpeta dedicada)
screenshot*.png
screen_*.png
ss_*.png
splash_*.png
emulator_*.png
app_*.png
screenshots/

# Python cache
__pycache__/

# Bundled JS assets (generated)
android/app/src/main/assets/

# Local keystore credentials
android/gradle.properties.local

# JVM crash logs
hs_err_pid*.log
replay_pid*.log

# CIMA API cache (generated data)
scripts/cima_cache/

# One-shot historical scripts (kept for reference, not part of active workflow)
scripts/_archive/

# Script tooling outputs (regenerable: diff docs, summaries)
scripts/_output/

# Local build logs (artifacts of dev sessions)
build_*.log
build_error.log

# UI hierarchy dumps from uiautomator (QA artifacts)
window_dump_*.xml

# Generated LogBox drawables from bundle --assets-dest
android/app/src/main/res/drawable-*/node_modules_*

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
